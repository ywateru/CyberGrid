{
  "name": "@cybergrid/sdk-js",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Read-only, memory-only CyberGrid console client",
  "license": "SEE LICENSE IN LICENSE",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "notices"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:integration": "npm run build && node --import ../server/node_modules/tsx/dist/loader.mjs --test test/service.integration.mjs",
    "test:bridge-integration": "npm run build && node --import ../server/node_modules/tsx/dist/loader.mjs --test test/bridge.integration.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
