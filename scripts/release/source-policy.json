{
  "schemaVersion": 1,
  "description": "Explicit public-source policy. Everything else is local archive material, never an implicit git add.",
  "rootFiles": [
    "README.md",
    "LICENSE",
    ".gitignore",
    ".gitattributes",
    "package.json",
    "vercel.json",
    ".vercelignore"
  ],
  "sourceRoots": [
    ".github",
    "api",
    "scripts/release",
    "server/src",
    "server/api",
    "server/test",
    "server/tests",
    "server/public",
    "server/notices",
    "server/scripts",
    "sdk",
    "sdk-rust",
    "sdk-js",
    "apps/tauri-test",
    "tools/cloudflared"
  ],
  "exactFiles": [
    "server/package.json",
    "server/package-lock.json",
    "server/tsconfig.json",
    "server/.env.example",
    "server/README.md",
    "server/release/build.mjs",
    "server/Dockerfile",
    "server/compose.yaml",
    "server/.dockerignore"
  ],
  "publicDocs": [
    "docs/architecture.md",
    "docs/deployment.md",
    "docs/sdk.md",
    "docs/releasing.md",
    "docs/getting-started.md",
    "docs/lab-browser-login.md",
    "docs/INDEX.md",
    "docs/redis-coordination.md",
    "docs/plan/README.md",
    "docs/plan/tasks/redis-001.md",
    "docs/plan/tasks/redis-002.md",
    "docs/plan/tasks/redis-003.md",
    "docs/plan/reviews/redis-003.md"
  ],
  "excludedParts": [
    ".git",
    ".build",
    ".vercel",
    "node_modules",
    "target",
    "dist",
    "dist-artifacts",
    "bin",
    "build",
    ".gradle",
    ".kotlin",
    ".idea",
    "__pycache__",
    ".private",
    "archive",
    "archives",
    "jniLibs",
    "schemas",
    "credentials",
    "private-device",
    "secrets",
    ".ssh",
    ".gnupg"
  ],
  "allowedBinaryRoots": [
    "tools/cloudflared/bin",
    "sdk/provider-assets",
    "sdk-rust/provider-assets",
    "apps/tauri-test/src-tauri/icons",
    "apps/tauri-test/src-tauri/gen/android/app/src/main/res"
  ],
  "excludedNames": [
    ".DS_Store",
    "local.properties",
    "tauri.settings.gradle",
    "tauri.build.gradle.kts",
    "tauri.properties",
    "deployment.json",
    "source-code-sha256-0.2.0.json"
  ],
  "excludedPrefixes": [
    "server/public/downloads/",
    "sdk-rust/docs/",
    "apps/tauri-test/src-tauri/gen/android/app/src/main/assets/",
    "tools/cloudflared/diagnostics/"
  ],
  "notes": [
    "Provider bin/jniLibs are explicit exceptions to generic build exclusions.",
    "Gradle wrapper JAR is a required checked-in build tool, not an application output.",
    "Only explicitly listed reviewed public docs are eligible; other local verification, product and plan records remain excluded.",
    "Credentials, .env files other than reviewed .env.example, local freezes and build logs are never public."
  ],
  "excludedExactFiles": [
    "tools/cloudflared/android-startup-check.json",
    "tools/cloudflared/check-android.sh",
    "apps/tauri-test/scripts/package-test.py"
  ]
}
