{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix server ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": ".vercel-static",
  "regions": ["iad1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "server/{public,notices}/**"
    }
  },
  "rewrites": [
    {"source": "/(.*)", "destination": "/api/index"}
  ]
}
