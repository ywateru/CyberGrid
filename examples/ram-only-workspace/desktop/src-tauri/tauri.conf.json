{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CyberGrid Workspace",
  "version": "0.1.0",
  "identifier": "tech.tinadev.cybergrid.workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CyberGrid Workspace",
        "width": 980,
        "height": 720,
        "minWidth": 380,
        "minHeight": 580,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
