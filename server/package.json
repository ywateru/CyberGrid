{
  "name": "cybergrid-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm start",
    "build": "tsc --noEmit && node release/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "owner": "npm start",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "test:node": "tsx --test test/node.test.ts test/http.test.ts test/owner.test.ts test/origin.test.ts",
    "test:origin": "tsx --test test/origin.test.ts"
  },
  "dependencies": {
    "jose": "^6.2.15",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
