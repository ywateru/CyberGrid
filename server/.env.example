# Stateless Node / Docker or Vercel Functions, shared Redis coordination.
# Optional: leave blank to use each request Host / strict single proxy headers.
CYBERGRID_PUBLIC_ORIGIN=
LOGTO_ISSUER=https://your-dedicated-tenant.logto.app/oidc
LOGTO_BROWSER_CLIENT_ID=your-independent-spa-client-id
# Optional comma-separated exact HTTPS origins (HTTP loopback for local development).
# Only console APIs receive CORS access; no wildcard or browser credentials.
CYBERGRID_BROWSER_ORIGINS=
LOGTO_MANAGEMENT_CLIENT_ID=your-directory-m2m-id
LOGTO_MANAGEMENT_CLIENT_SECRET=
# Optional independent 32..256 UTF8-byte read-only administrator key.
CYBERGRID_ADMIN_KEY=
# Fixed OAuth audience, independent of request Host; register the identical Logto API resource.
# Default: PUBLIC_ORIGIN + /api when set; otherwise https://cybergrid.local/api (no DNS needed).
# Existing installations should explicitly preserve their prior resource before removing PUBLIC_ORIGIN.
# LOGTO_RESOURCE=https://cybergrid.local/api
# Optional dedicated same-origin console callback; register the exact visited URI in Logto.
# CYBERGRID_CONSOLE_REDIRECT_URI=https://your-grid.example/console/callback/
CYBERGRID_BIND=127.0.0.1
PORT=7400
# Optional exact selector: tcp, upstash-rest, vercel-kv.
# An explicit selector uses only that group (other Marketplace variables are ignored).
# Without a selector, configure exactly one complete group; partial/conflicting groups fail.
# CYBERGRID_REDIS_TRANSPORT=vercel-kv
# REDIS_URL=redis://127.0.0.1:6379
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=https://your-database.upstash.io
# KV_REST_API_TOKEN=
# KV_URL and KV_REST_API_READ_ONLY_TOKEN are not write credentials and are never used.
# Separate production, previews and tests. Letters/numbers/colon/underscore/hyphen only.
CYBERGRID_REDIS_PREFIX=cybergrid:v1
# Shared limits must be identical for all instances within a namespace.
# CYBERGRID_LIMITS={"sessions":256,"registrationKeys":1024}

# Limits may only lower the built-in Redis hard caps; storage requires noeviction.
