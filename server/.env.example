# Owner-only identity and directory configuration. Never expose to website/SDK.
LOGTO_ISSUER=https://your-dedicated-tenant.logto.app/oidc
LOGTO_BROWSER_CLIENT_ID=your-independent-spa-client-id
LOGTO_MANAGEMENT_CLIENT_ID=your-directory-m2m-id
LOGTO_MANAGEMENT_CLIENT_SECRET=
# Both trusted Vercel proxy and owner need the same private 32..256-byte key.
CYBERGRID_PROXY_SECRET=
CYBERGRID_PUBLIC_ORIGIN=https://your-grid.example
# Proxy-only fixed HTTPS origin; no path and no local MemoryStore fallback.
CYBERGRID_OWNER_URL=https://your-owner-host.example
# Owner-only optional read-only admin key: 32..256 UTF8 bytes. Empty disables admin.
# Use a random ASCII key, keep only in the owner's private .env; never proxy/website.
CYBERGRID_ADMIN_KEY=
# Optional owner-only Logto API resource; default PUBLIC_ORIGIN + /api.
# LOGTO_RESOURCE=https://your-grid.example/api
# Optional same-origin callback. Set the identical value on owner and website proxy;
# register this exact URI on your own Logto SPA. Default PUBLIC_ORIGIN + /console/callback/.
# CYBERGRID_CONSOLE_REDIRECT_URI=https://your-grid.example/console/callback/
# The website proxy also uses public LOGTO_ISSUER for its exact CSP origin.
# Owner-only: exactly one process. HTTPS public gateway forwards to this bind.
CYBERGRID_BIND=127.0.0.1
PORT=7400
# CYBERGRID_OWNER_LOCK=.cybergrid-owner.lock
# CYBERGRID_MEMORY_LIMITS={"sessions":10000,"registrationKeys":10000}
